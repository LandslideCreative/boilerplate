{
    "name": "landslidecreative/ls-boilerplate-wp",
    "authors": [
        {
            "name": "Landslide Creative",
            "email": "info@landslidecreative.com"
        }
    ],
    "repositories" : [
        {
            "type" : "composer",
            "url"  : "https://wpackagist.org"
        },
        {
            "type":"composer",
            "url":"https://connect.advancedcustomfields.com"
        },
        {
           "type" : "vcs",
           "url" : "git@github.com:jsjenkins/backup-backup-pro.git"
        },
        {
            "type": "composer",
            "url": "https://composer.gravity.io"
        },        
        {
           "type" : "vcs",
           "url" : "git@github.com:jsjenkins/events-calendar-pro.git"
        },
        {
            "type":"composer",
            "url":"https://composer.deliciousbrains.com"
        }
    ],
    "extra" : {
        "installer-paths" : {
            "wp-content/plugins/{$name}/" : ["type:wordpress-plugin"],
            "wp-content/themes/{$name}/" : ["type:wordpress-theme"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable" : true,
    "require": {
        "wpengine/advanced-custom-fields-pro": "6.8.9",
        "wpackagist-plugin/akismet" : "*",
        "wpackagist-plugin/backup-backup" : "2.1.7",
        "landslidecreative/backup-backup-pro" : "2.1.7",
        "wpackagist-plugin/classic-editor" : "*",
        "gravity/gravityforms": "3.1.0.2",
        "gravity/gravityformsakismet": "1.1.0",
        "wpackagist-plugin/imagify" : "*",
        "wpackagist-plugin/intuitive-custom-post-order" : "3.2.0",
        "wpackagist-plugin/query-monitor" : "*",
        "wpackagist-plugin/safe-redirect-manager" : "*",
        "wpackagist-plugin/svg-support" : "*",
        "wpackagist-plugin/the-events-calendar" : "6.17.3.1",
        "landslidecreative/events-calendar-pro" : "7.8.1",
        "wpackagist-plugin/user-switching" : "*",
        "wpackagist-plugin/wordfence" : "*",
        "wpackagist-plugin/wp-crontrol" : "*",
        "wpackagist-plugin/wp-mail-smtp" : "*",
        "deliciousbrains-plugin/wp-migrate-db-pro": "*",
        "wpackagist-plugin/yet-another-related-posts-plugin" : "5.30.11",
        "wpackagist-plugin/duplicate-post" : "*",
        "wpackagist-plugin/wordpress-seo" : "28.3"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
